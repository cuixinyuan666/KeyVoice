<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      主题与 Windows 接收端（pc/keyvoice_box.py）共用同一套 token。

      关键点：Ui 里的 light 标志只影响【代码创建的视图】；系统弹层（Spinner 下拉、
      AlertDialog、Toast、输入法）走的是 Activity 的 android:theme，所以这里必须准备
      深色 / 浅色两套，由 Activity.onCreate 在构建任何视图之前 setTheme() 选中，
      否则切到浅色主题时系统弹层仍是深色 —— 这就是「主题不统一」的根因。
    -->

    <!-- 深色（默认）：与 Windows 接收端一致 -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/kv_bg</item>
        <item name="android:colorBackground">@color/kv_bg</item>
        <item name="android:colorForeground">@color/kv_text</item>
        <item name="android:textColorPrimary">@color/kv_text</item>
        <item name="android:textColorSecondary">@color/kv_text2</item>
        <item name="android:textColorTertiary">@color/kv_text3</item>
        <item name="android:colorPrimary">@color/kv_primary</item>
        <item name="android:colorPrimaryDark">@color/kv_bg</item>
        <item name="android:colorAccent">@color/kv_primary</item>
        <item name="android:colorControlActivated">@color/kv_primary</item>
        <item name="android:colorControlNormal">@color/kv_text3</item>
        <item name="android:colorControlHighlight">@color/kv_primary_dim</item>
        <item name="android:colorButtonNormal">@color/kv_surface_hi</item>
        <item name="android:popupBackground">@color/kv_surface_hi</item>
    </style>

    <!-- 浅色：与主页面共用一套 token，只是换成 kvl_* -->
    <style name="AppTheme.Light" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/kvl_bg</item>
        <item name="android:colorBackground">@color/kvl_bg</item>
        <item name="android:colorForeground">@color/kvl_text</item>
        <item name="android:textColorPrimary">@color/kvl_text</item>
        <item name="android:textColorSecondary">@color/kvl_text2</item>
        <item name="android:textColorTertiary">@color/kvl_text3</item>
        <item name="android:colorPrimary">@color/kv_primary</item>
        <item name="android:colorPrimaryDark">@color/kvl_border</item>
        <item name="android:colorAccent">@color/kv_primary</item>
        <item name="android:colorControlActivated">@color/kv_primary</item>
        <item name="android:colorControlNormal">@color/kvl_text3</item>
        <item name="android:colorControlHighlight">@color/kvl_border</item>
        <item name="android:colorButtonNormal">@color/kvl_surface</item>
        <item name="android:popupBackground">@color/kvl_surface</item>
    </style>

    <!-- Translucent top-anchored input window (VoiceInputActivity). -->
    <style name="TranslucentTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:textColorPrimary">@color/kv_text</item>
        <item name="android:textColorSecondary">@color/kv_text2</item>
        <item name="android:colorAccent">@color/kv_primary</item>
        <item name="android:colorBackground">@color/kv_bg</item>
    </style>
</resources>
